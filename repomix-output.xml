USE pipocalizando;

CREATE TABLE IF NOT EXISTS seat_reservations (
  id INT AUTO_INCREMENT PRIMARY KEY,
  session_id INT NOT NULL,
  movie_id INT NOT NULL,
  user_id INT NOT NULL,
  seat_label VARCHAR(10) NOT NULL,
