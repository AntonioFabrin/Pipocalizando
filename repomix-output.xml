  ON tickets (order_id);

CREATE INDEX IF NOT EXISTS idx_tickets_session
  ON tickets (session_id);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tickets_session_seat
  ON tickets (session_id, seat_label);

DESCRIBE tickets;
