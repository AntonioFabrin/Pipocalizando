USE pipocalizando;

ALTER TABLE tickets
  ADD COLUMN IF NOT EXISTS seat_label  VARCHAR(10)  NULL AFTER ticket_code,
  ADD COLUMN IF NOT EXISTS movie_id    INT          NULL AFTER seat_label,
  ADD COLUMN IF NOT EXISTS session_id  INT          NULL AFTER movie_id,
