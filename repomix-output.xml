SELECT
  m.title,
  mc.name AS categoria,
  mc.emoji,
  mr.name AS sala,
  mr.type AS tipo_sala,
  m.rating AS classificacao,
  m.status
FROM movies m
LEFT JOIN movie_categories mc ON m.category_id = mc.id
LEFT JOIN movie_rooms mr ON m.room_id = mr.id
ORDER BY m.status DESC, m.session_date;
