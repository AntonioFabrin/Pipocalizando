PORT=3333
NODE_ENV=development
# Em producao, use a origem publica do frontend para cookies autenticados.
CORS_ORIGIN=http://localhost:3000
# Opcional em desenvolvimento. Em producao, use a URL HTTPS publica do frontend
# para habilitar os retornos automaticos do Checkout Pro em produtos e ingressos.
FRONTEND_URL=

DATABASE_URL=postgresql://postgres.dcrsnyszhwifneewhxje:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dcrsnyszhwifneewhxje.supabase.co:5432/postgres

JWT_SECRET=troque-por-uma-chave-segura

# Mercado Pago
# Use a chave privada/access token da sua aplicacao. Nao commite o token real.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# Opcional para testes sandbox. Use um email de comprador de teste se precisar
# forcar o payer do Mercado Pago sem depender do email do usuario cadastrado.
MERCADO_PAGO_PAYER_EMAIL_OVERRIDE=

# Para Checkout Pro com credenciais de teste APP_USR, use production e abra o init_point.
# Se estiver usando credenciais TEST, pode usar sandbox para abrir sandbox_init_point.
MERCADO_PAGO_CHECKOUT_MODE=production

# Opcional em desenvolvimento. Em producao, use a URL publica:
# https://seu-dominio.com/api/payments/mercadopago/webhook
MERCADO_PAGO_WEBHOOK_URL=

# Opcional, mas recomendado. Quando definido, inclua o mesmo valor na URL:
# https://seu-dominio.com/api/payments/mercadopago/webhook?secret=valor-forte
MERCADO_PAGO_WEBHOOK_SECRET=
